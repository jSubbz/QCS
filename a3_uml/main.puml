@startuml
skinparam dpi 150
left to right direction

actor User

rectangle "Design Mode" {
  usecase "Place Quantum Gate"
  usecase "Select Quantum Gate"
  usecase "Clear Quantum Gate"
  usecase "Create New Circuit"
  usecase "Resize Grid"
  usecase "Adjust Phase Parameters"
}

rectangle "Play Mode" {
  usecase "Step Simulation"
  usecase "Reset Simulation"
  usecase "Run Full Simulation"
}

rectangle "SettingsWindow" {
  usecase "Toggle Design / Play Mode"
  usecase "Change Language"
  usecase "Change Theme"
  usecase "Change Gate Colors"
}

rectangle "MenuBarPanel" {
  usecase "Save Circuit to File"
  usecase "Load Circuit from File"
  usecase "View About Information"
  usecase "View Readme/Tutorial"
  usecase "Exit Application"
}

' User interactions
User --> "Place Quantum Gate"
User --> "Select Quantum Gate"
User --> "Clear Quantum Gate"
User --> "Create New Circuit"
User --> "Resize Grid"
User --> "Adjust Phase Parameters"

User --> "Step Simulation"
User --> "Reset Simulation"
User --> "Run Full Simulation"

User --> "Toggle Design / Play Mode"
User --> "Change Language"
User --> "Change Theme"
User --> "Change Gate Colors"

User --> "Save Circuit to File"
User --> "Load Circuit from File"
User --> "View About Information"
User --> "View Readme/Tutorial"
User --> "Exit Application"

' Relationships
"Place Quantum Gate" --> "Select Quantum Gate" : <<includes>>
"Clear Quantum Gate" --> "Select Quantum Gate" : <<includes>>
"Create New Circuit" --> "Resize Grid" : <<includes>>
"Step Simulation" --> "Place Quantum Gate" : <<extends>>

"Toggle Design / Play Mode" --> "Place Quantum Gate" : <<enables>>
"Toggle Design / Play Mode" --> "Resize Grid" : <<enables>>
"Toggle Design / Play Mode" --> "Create New Circuit" : <<enables>>
"Toggle Design / Play Mode" --> "Adjust Phase Parameters" : <<enables>>

"Toggle Design / Play Mode" --> "Step Simulation" : <<enables>>
"Toggle Design / Play Mode" --> "Reset Simulation" : <<enables>>
"Toggle Design / Play Mode" --> "Run Full Simulation" : <<enables>>

@enduml
